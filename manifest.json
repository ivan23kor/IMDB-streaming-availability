{
  "name": "Just Watch IMDB",
  "description": "Instantly see streaming availability from JustWatch directly on IMDb pages!",
  "version": "1.0.4",
  "manifest_version": 3,
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "https://www.imdb.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "/scripts/scrape.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.justwatch.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "/assets/*"
      ],
      "matches": [
        "https://www.imdb.com/*"
      ]
    }
  ]
}